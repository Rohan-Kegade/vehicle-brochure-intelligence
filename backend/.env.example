# Copy to .env and fill in. .env is gitignored.

# App
APP_NAME="Vehicle Brochure Intelligence"
ENVIRONMENT=development
LOG_LEVEL=info

# CORS — frontend dev server origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Infrastructure — defaults match backend/docker-compose.yml
DATABASE_URL=postgresql+asyncpg://vbi:vbi@localhost:5433/vbi
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks

# Uploaded PDFs are written here (relative to backend/). Gitignored.
STORAGE_DIR=storage

# Gemini — required for POST /conversations/{id}/messages
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Auth / sessions
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Set COOKIE_SECURE=true anywhere that isn't local http.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_BASE_URL=http://localhost:5173

# Google OAuth — "Continue with Google" is disabled until both are set.
# Authorised redirect URI (Google console) must match GOOGLE_OAUTH_REDIRECT_URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
