# Copy to .env and fill in. .env is gitignored.

# App
APP_NAME="Vehicle Brochure Intelligence"
ENVIRONMENT=development
LOG_LEVEL=info

# CORS — frontend dev server origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Infrastructure — defaults match backend/docker-compose.yml
DATABASE_URL=postgresql+asyncpg://vbi:vbi@localhost:5433/vbi
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks

# Uploaded PDFs are written here (relative to backend/). Gitignored.
STORAGE_DIR=storage

# Claude — required for POST /conversations/{id}/messages
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
