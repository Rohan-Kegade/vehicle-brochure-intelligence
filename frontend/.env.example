# Optional override. Copy to .env.local (gitignored).
#
# Default without this: real backend under `npm run dev`, mocked in a
# production build. Force one mode:
#   VITE_USE_MOCK=false  -> always call the FastAPI backend (via the /api proxy)
#   VITE_USE_MOCK=true   -> always use the built-in mock, no backend needed
VITE_USE_MOCK=false
